# Copy to .env (never commit .env). Local values match docker-compose.yml.

# The app: restricted role, cannot UPDATE/DELETE/backdate audit_events.
# Deployed on Supabase from serverless functions: the POOLED connection string, user ap_app.
DATABASE_URL=postgres://ap_app:ap_app_local@localhost:5432/harborline

# Migrations + seed only: the owner. On Supabase: the DIRECT connection string.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/harborline
