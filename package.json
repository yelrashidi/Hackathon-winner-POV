{
  "name": "harborline-ap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:imports": "tsx scripts/check-imports.ts",
    "test:contracts": "vitest run src/contracts/__tests__",
    "check": "npm run typecheck && npm run check:imports && npm test && npm run validate:batch && npm run validate:history",
    "validate:batch": "tsx scripts/validate-batch.ts",
    "validate:history": "tsx scripts/validate-history.ts",
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "gmail:poll": "tsx scripts/gmail-poll.ts",
    "intake:dataset": "tsx scripts/intake-dataset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@googleapis/gmail": "22.0.2",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
